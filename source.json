  "news": [
    {
      "title": "MrLTTec Control 1.0.27 is here",
      "identifier": "mrlttec-control-1.0.27",
      "caption": "Run the whole room from your iPhone: lights, TV, music and the gaming PC, on your home Wi-Fi or anywhere over Tailscale.\n\nWhat's new:\n• Big Now Playing page: drag the progress bar, shuffle, repeat, volume and Up Next\n• New Music tab: search all your songs, MrLTTec Favorites / Brazileroas / All songs, Shuffle, cover art\n• New TV remote with power and input, plus YouTube, MrLTTec Music, Live TV and MovieBox buttons\n• Type on TV\n• Tap the Gaming PC card for its stats and to launch Steam, Fortnite, Minecraft or Discord\n• Phone volume buttons change the TV volume (Settings)\n• Open MrLTTec Home from Settings\n• Faster buttons: the screen changes right away",
      "date": "2026-11-15T22:17:46Z",
      "tintColor": "#45342B",
      "notify": false,
